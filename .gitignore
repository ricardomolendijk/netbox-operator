# Local design authority — deliberately not published.
# plan.md / roadmap.md / specs/ are projected onto GitHub issues instead.
/plan.md
/roadmap.md
/specs/

# Build output
/bin/
# Without a slash too: `/bin/` matches a directory, so a *symlink* named `bin` -- which is
# what you get from pointing a worktree at the main checkout's envtest assets -- is not
# ignored and can be committed. One was, and CI failed on `mkdir -p bin` with a bare
# "Error 1", because mkdir will not create a directory over a dangling symlink.
/bin
/dist/
/testbin/
*.test
cover.out
cover.html

# Byte-compiled hack/*.py. A .pyc of the gitignored hack/sync-issues.py was committed
# once already, which published the source it exists to keep local.
__pycache__/
*.py[cod]

# Local config and secrets
.env
*.local.yaml
kubeconfig
/config/**/*secret*.yaml

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Aspirational design example; the published examples land per-milestone as kinds
# become real. See docs/examples/README.md.
/docs/examples/homelab.yaml

# Syncs the local specs onto GitHub issues; local because specs/ is.
/hack/sync-issues.py

# Agent worktrees and local Claude Code state.
/.claude/

# Docs site build output. Not committed, and so deliberately not in the Makefile's
# GENERATED_PATHS: `make docs-build` regenerates it from docs/ in under two seconds.
/site/

# Local scratch: the session system prompt, written on request. Never commit.
/system.md
